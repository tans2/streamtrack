# Scout backend environment
# Copy to .env and fill in. Values marked REQUIRED will stop the server booting.

# ---- Server ----
PORT=5001
NODE_ENV=development

# REQUIRED. The server now refuses to start without this rather than falling
# back to a shared default (which would let anyone forge a login token).
# Generate one with:  openssl rand -hex 32
JWT_SECRET=

# ---- Supabase ----
# REQUIRED. The backend uses the SERVICE ROLE key and bypasses RLS.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- TMDB ----
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3

# ---- Email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM=Scout <onboarding@resend.dev>

# REQUIRED for cron + debug endpoints. If unset those endpoints now return 503
# instead of running unauthenticated — episode polling and the daily digest
# will stop. Must match the CRON_SECRET GitHub Actions secret.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=

# ---- URLs / CORS ----
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Comma-separated Vercel project prefixes allowed as preview origins.
# Only "<prefix>.vercel.app" and "<prefix>-*.vercel.app" are accepted, so other
# Vercel customers' deployments cannot call this API with credentials.
VERCEL_PREVIEW_PREFIXES=tvscout,streamtrack,scout

# ---- Optional ----
# Enables the in-app bug report button to file GitHub issues.
GITHUB_TOKEN=
