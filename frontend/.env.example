# Scout frontend environment
# Copy to .env.local and fill in.

# Backend API base URL.
NEXT_PUBLIC_API_URL=http://localhost:5001

# ---- Product analytics (optional) ----
# Without a key the analytics provider is completely inert — no network calls,
# no cookies — so leaving these blank is safe for local development.
# Get the key from PostHog → Project Settings → Project API Key.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
